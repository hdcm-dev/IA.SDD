--- package.json
{
  "name": "<f1>-<componente>",
  "version": "0.0.0",
  "private": true,
  "description": "TypeScript del componente que dibuja la cabecera de pines. Se construye dentro del dotnet build (ADR-00042).",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && esbuild ts/<componente>.ts --bundle --format=esm --minify --outfile=wwwroot/<componente>.js",
    "test": "tsc -p tsconfig.pruebas.json && node --test build/*.test.js",
    "test:cobertura": "tsc -p tsconfig.pruebas.json && node --test --experimental-test-coverage --test-coverage-exclude=\"build/*.test.js\" build/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  }
}

